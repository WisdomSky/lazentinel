# Server port (default: 3000)
PORT=3000

# Tracking interval in minutes, applied on startup in all modes.
# Unset or empty falls back to 5 minutes.
TRACKING_INTERVAL_MINUTES=5

# SQLite database file. Its parent directory is created automatically.
DATABASE_PATH=./data/lazentinel.db

# Enable accounts and per-user watchlists. Only the exact value "true" enables it.
ENABLE_MULTIUSER=false

# Separate SQLite database for accounts and sessions.
AUTH_DATABASE_PATH=./data/lazentinel-auth.db

# Set to true only when serving over HTTPS.
COOKIE_SECURE=false

# Directory containing the built client (Vite output)
CLIENT_DIST=./client/dist

# Optional: path to a local Chromium executable. Usually unnecessary — run
# `npm run setup:browser` to download CloakBrowser's stealth Chromium, or let
# the first scrape download it. CHROMIUM_EXECUTABLE is accepted as a legacy alias.
# CLOAKBROWSER_BINARY_PATH=/usr/bin/chromium

# Optional: where CloakBrowser caches its stealth Chromium binary.
# CLOAKBROWSER_CACHE_DIR=~/.cloakbrowser

# Optional: CloakBrowser Pro license key for the newest stealth binary.
# CLOAKBROWSER_LICENSE_KEY=cb_xxxxxxxx

# Optional: 2Captcha API key. When set, the Browser API is used only after
# every proxy host in server/proxy/proxy_locations.json has failed for a URL.
# TWOCAPTCHA_API_KEY=

# Rotate Lazada requests through the proxy hosts in
# server/proxy/proxy_locations.json. Credentials are resolved from
# server/proxy/proxy_auth_providers.json and cached per host.
# Set PROXY_ENABLED=false to connect directly instead.
PROXY_ENABLED=true

# Protocol used by the locations list: http (default) or socks5.
PROXY_SCHEME=http

# Optional: a single static proxy instead of the rotating host list.
# Setting this disables the resolver above.
# CLOAKBROWSER_PROXY=http://user:pass@proxy.example.com:8080
