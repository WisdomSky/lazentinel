# Server port (default: 3000)
PORT=3000

# SQLite database file. Its parent directory is created automatically.
DATABASE_PATH=./data/lazentinel.db

# Enable accounts and per-user watchlists. Only the exact value "true" enables it.
ENABLE_MULTIUSER=false

# Separate SQLite database for accounts and sessions.
AUTH_DATABASE_PATH=./data/lazentinel-auth.db

# Set to true only when serving over HTTPS.
COOKIE_SECURE=false

# Directory containing the built client (Vite output)
CLIENT_DIST=./client/dist

# Optional: path to a Chrome/Chromium executable. Usually unnecessary —
# run `npm run setup:browser` instead, or use the Docker image.
# CHROMIUM_EXECUTABLE=/usr/bin/chromium
