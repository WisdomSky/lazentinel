{
  "name": "lazentinel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lazentinel — track Lazada product prices over time with a live, animated sentinel.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=3001 tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:server && npm --prefix client run build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && npm --prefix client run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx server/seed-demo.ts",
    "setup:browser": "playwright-core install chromium",
    "docker": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
